# =============================================================
# .env.example
#
# 실제 값이 들어간 .env 는 절대 커밋하지 않는다.
# 사용법:
#   cp .env.example .env     (그리고 .env 안의 값을 채운다)
#
# 새 환경변수를 추가하면 이 파일에도 "값 없이" 같이 추가한다.
# 기술 스택이 확정되면 필요한 항목을 여기에 늘려간다.
# =============================================================

# ---- 실행 환경 ----
APP_ENV=development

# ---- 백엔드 서버 ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ---- 프론트엔드 ----
# 프론트에서 호출할 백엔드 주소
API_BASE_URL=http://127.0.0.1:8000

# ---- 데이터베이스 (사용이 확정되면 채운다) ----
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- 경로 ----
DATA_DIR=./data
MODEL_DIR=./models
